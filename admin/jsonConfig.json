{
  "type": "panel",
  "i18n": false,
  "items": {
    "_hdr": {
      "type": "header",
      "text": "Modbus TCP (WLAN-Stick)",
      "size": 3,
      "newLine": true
    },
    "host": {
      "type": "text",
      "label": "IP-Adresse des WLAN-Sticks",
      "help": "Im Router fest zuweisen",
      "newLine": true,
      "xs": 12,
      "sm": 6,
      "md": 4,
      "lg": 3
    },
    "port": {
      "type": "number",
      "label": "Port",
      "min": 1,
      "max": 65535,
      "xs": 6,
      "sm": 3,
      "md": 2,
      "lg": 2
    },
    "unitId": {
      "type": "number",
      "label": "Slave-ID",
      "help": "Standard 1",
      "min": 0,
      "max": 247,
      "xs": 6,
      "sm": 3,
      "md": 2,
      "lg": 2
    },
    "encryption": {
      "type": "select",
      "label": "Verschlüsselung",
      "newLine": true,
      "xs": 12,
      "sm": 6,
      "md": 4,
      "lg": 3,
      "options": [
        {
          "label": "Automatisch erkennen",
          "value": "auto"
        },
        {
          "label": "Immer verschlüsselt",
          "value": "on"
        },
        {
          "label": "Aus (Standard-Modbus)",
          "value": "off"
        }
      ]
    },
    "interval": {
      "type": "number",
      "label": "Abfrageintervall (Sekunden)",
      "min": 5,
      "max": 3600,
      "xs": 12,
      "sm": 6,
      "md": 4,
      "lg": 3
    },
    "keepConnection": {
      "type": "checkbox",
      "label": "Verbindung offen halten (sonst nach jeder Abfrage trennen, damit andere Programme zugreifen können)",
      "newLine": true,
      "xs": 12
    }
  }
}
