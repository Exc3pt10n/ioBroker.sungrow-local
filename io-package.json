    "version": "0.3.0",
    "news": {
      "0.3.0": {
        "en": "Renamed to sungrow-local, cloud mode removed",
        "de": "Umbenannt in sungrow-local, Cloud-Modus entfernt"
      },
      "0.2.0": {
        "en": "Local mode: Modbus TCP via WiFi dongle incl. Sungrow encryption",
        "de": "Lokaler Modus: Modbus TCP über WLAN-Stick inkl. Sungrow-Verschlüsselung"
      },
      "0.1.0": {
        "en": "Initial version",
        "de": "Erste Version"
      }
    },
    "titleLang": {
      "en": "Sungrow local (Modbus TCP)",
      "de": "Sungrow lokal (Modbus TCP)"
    },
    "desc": {
      "en": "Reads Sungrow inverters locally via Modbus TCP of the WiFi dongle (incl. Sungrow encryption)",
