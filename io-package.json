    },
    "authors": [
      "Sebastian <kontakt@jansesoft.de>"
    ],
    "keywords": [
      "sungrow",
      "modbus",
      "solar",
      "pv",
      "inverter"
    ],
    "license": "MIT",
    "platform": "Javascript/Node.js",
    "icon": "sungrow-local.png",
    "enabled": true,
    "extIcon": "",
    "readme": "",
    "loglevel": "info",
    "mode": "daemon",
    "type": "energy",
    "compact": true,
    "connectionType": "local",
    "dataSource": "poll",
    "adminUI": {
      "config": "json"
    },
    "dependencies": [
      {
        "js-controller": ">=5.0.19"
      }
    ],
    "globalDependencies": [
      {
        "admin": ">=6.0.0"
      }
    ]
  },
  "encryptedNative": [],
  "protectedNative": [],
  "native": {
    "host": "",
    "port": 502,
    "unitId": 1,
    "encryption": "auto",
    "interval": 30,
    "keepConnection": false
  },
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": "Information"
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "role": "indicator.connected",
        "name": "Verbunden mit Wechselrichter",
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    }
  ]
