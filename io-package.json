{
  "common": {
    "name": "sungrow-cloud",
    "version": "0.2.0",
    "news": {
      "0.2.0": {
        "en": "Local mode: Modbus TCP via WiFi dongle incl. Sungrow encryption",
        "de": "Lokaler Modus: Modbus TCP über WLAN-Stick inkl. Sungrow-Verschlüsselung"
      },
      "0.1.0": {
        "en": "Initial version",
        "de": "Erste Version"
      }
    },
    "titleLang": {
      "en": "Sungrow iSolarCloud",
      "de": "Sungrow iSolarCloud"
    },
    "desc": {
      "en": "Reads Sungrow inverters locally via (encrypted) Modbus TCP of the WiFi dongle or via the iSolarCloud API",
      "de": "Liest Sungrow Wechselrichter lokal über (verschlüsseltes) Modbus TCP des WLAN-Sticks oder über die iSolarCloud-API"
    },
    "authors": [
      "Sebastian <kontakt@jansesoft.de>"
    ],
    "keywords": [
      "sungrow",
      "isolarcloud",
      "solar",
      "pv",
      "inverter"
    ],
    "license": "MIT",
    "platform": "Javascript/Node.js",
    "icon": "sungrow-cloud.png",
    "enabled": true,
    "extIcon": "",
    "readme": "",
    "loglevel": "info",
    "mode": "daemon",
    "type": "energy",
    "compact": true,
    "connectionType": "local",
    "dataSource": "poll",
    "adminUI": {
      "config": "json"
    },
    "dependencies": [
      {
        "js-controller": ">=5.0.19"
      }
    ],
    "globalDependencies": [
      {
        "admin": ">=6.0.0"
      }
    ]
  },
  "encryptedNative": [
    "password",
    "accessKey"
  ],
  "protectedNative": [
    "password",
    "accessKey"
  ],
  "native": {
    "mode": "modbus",
    "host": "",
    "port": 502,
    "unitId": 1,
    "encryption": "auto",
    "modbusInterval": 30,
    "keepConnection": false,
    "server": "eu",
    "appKey": "",
    "accessKey": "",
    "rsaKey": "",
    "username": "",
    "password": "",
    "interval": 300,
    "readInverters": true
  },
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": "Information"
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "role": "indicator.connected",
        "name": "Verbunden mit Wechselrichter bzw. iSolarCloud",
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    }
  ]
}
